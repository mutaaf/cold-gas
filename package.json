{
  "name": "cold-gas",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "COLD GAS: a keynote-minimal 3D stunt game. Ten cold-gas thrusters, one roll, one landing, an AI judge panel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:crazygames": "node scripts/portal-build.mjs crazygames",
    "build:gamedistribution": "node scripts/portal-build.mjs gamedistribution",
    "build:portals": "node scripts/portal-build.mjs crazygames && node scripts/portal-build.mjs gamedistribution",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "node scripts/serve-and-audit.mjs",
    "lint": "eslint .",
    "check": "node scripts/check-backlog.mjs && node scripts/vectors.mjs --check && npm run lint && npm test && npm run e2e",
    "check:fast": "node scripts/check-backlog.mjs && node scripts/vectors.mjs --check && npm run lint && npm test && npm run build",
    "up": "npm install && npx playwright install chromium && npm run dev",
    "determinism": "node scripts/determinism.mjs",
    "heal": "node scripts/heal.mjs",
    "obs:bench": "node --expose-gc scripts/obs-bench.mjs",
    "alloc:bench": "node scripts/alloc-bench.mjs",
    "vectors": "node scripts/vectors.mjs",
    "forge": "node tools/forge/forge.mjs",
    "forge:brief": "node tools/forge/brief.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@dimforge/rapier3d-deterministic": "0.21.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "aurora-field": "^3.3.0",
    "openai": "^7.47.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "meshoptimizer": "^1.3.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.156.0"
  }
}
