{
  "_doc": "Short-form clips (npm run clips; scripts/clips.mjs). Segments cut takes from a mark ('air', 'landed+1.2') for a length at a speed; caption times are seconds or '<segment>:<mark>[+-s]'. Caption lines: at most 2, at most 5 words, *word* = accent. Every caption must say what the game really does: no scores, no claims. No dashes.",
  "size": {
    "width": 1080,
    "height": 1920
  },
  "style": {
    "fonts": [
      {
        "family": "Geist",
        "file": "node_modules/@fontsource-variable/geist/files/geist-latin-wght-normal.woff2"
      },
      {
        "family": "Michroma",
        "file": "node_modules/@fontsource/michroma/files/michroma-latin-400-normal.woff2",
        "weight": 400
      }
    ],
    "font": "'Geist', sans-serif",
    "weight": 900,
    "size": 100,
    "tracking": "-0.01em",
    "accent": "#ff5a62",
    "captionTop": 300
  },
  "endCard": {
    "mark": "<div style=\"font-family:Michroma;font-size:92px;letter-spacing:.08em;line-height:1.05;-webkit-text-stroke:10px #000;paint-order:stroke fill\">COLD<br>GAS</div>",
    "kicker": "Play free at",
    "url": "mutaafaziz.com/coldgas",
    "pill": "#ff5a62",
    "pillText": "#0b0b0d",
    "sub": "In your browser. No download.",
    "seconds": 1.8
  },
