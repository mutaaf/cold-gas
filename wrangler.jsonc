{
  // cold-gas: static assets under mutaafaziz.com/coldgas/ plus the judging + leaderboard API.
  // The route takes precedence over the mutaafaziz.com Custom Domain (the personal site).
  // Operator-owned file (agents/control.json → frozen_paths).
  "name": "cold-gas",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "main": "src/worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/coldgas/api/*", "/coldgas/", "/coldgas/index.html"] },
  // No database_id on purpose: Workers Builds provisions this D1 database by name on first
  // deploy. The Worker creates its own tables.
  "d1_databases": [{ "binding": "DB", "database_name": "cold-gas" }],
  // The judges' default brain: an open model on Workers AI, through Prompter (github.com/mutaaf/prompter), which
  // shares the account's free allowance between apps (Cold Gas: 3,000 neurons a day guaranteed). Players can
  // bring their own Anthropic / OpenAI / xAI / Gemini key instead (src/worker/ai/providers.js); those never go through Prompter.
  // CUE is the portfolio's event backbone. props.source is how Cue knows who's talking; a Worker can't claim another's name.
  "services": [{ "binding": "AI", "service": "prompter", "props": { "app": "cold-gas" } }, { "binding": "CUE", "service": "cue", "props": { "source": "cold-gas" } }],
  "routes": [{ "pattern": "mutaafaziz.com/coldgas*", "zone_name": "mutaafaziz.com" }]
}
